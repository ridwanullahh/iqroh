# ============================================================
# Iqroh - Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# Iqroh uses in-codebase data (lib/curriculum-data.ts) and does NOT
# require a database. Env vars below are optional deployment helpers.
# ============================================================

# ---- Cloudflare Pages deployment (used by the deploy script) ----
CLOUDFLARE_ACCOUNT_ID=15e9c5b50883ba36464fef9aa90937e1
CLOUDFLARE_API_TOKEN=replace-with-real-token
CLOUDFLARE_PROJECT_NAME=iqroh

# ---- App config ----
NEXT_PUBLIC_APP_URL=https://iqroh.pages.dev
NEXT_PUBLIC_APP_NAME=Iqroh

# ---- Audio CDN (optional - for pronunciation audio files) ----
# If empty, the app uses the bundled Web Audio API speech synthesis.
AUDIO_CDN_BASE=

# ---- Sentry (optional - error tracking) ----
SENTRY_DSN=
